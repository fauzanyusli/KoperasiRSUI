rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // DEV — setara test mode, buat demo kuliah: baca/tulis bebas.
    // Sebelum produksi, ganti blok bawah jadi production (lihat komentar).
    //
    // PRODUCTION (Seeder jalan sebelum login, jadi butuh anonymous sign-in
    // dulu di Application.onCreate sebelum rules ini dipakai):
    //
    // match /{document=**} {
    //   allow read, write: if request.auth != null;
    // }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
